# Maintainer: Andrew Imm <aimm22@gmail.com>
#
# Builds dvt from the committed HEAD of the repository this file lives in:
#   cd packaging/arch && makepkg -si
# To build from a remote instead, point `source` at it, e.g.
#   source=("dvt::git+https://github.com/<user>/dvt.git")

pkgname=dvt
pkgver=0.1.0.r3.g1a73055
pkgrel=1
pkgdesc='Read-only terminal disk usage visualizer with treemap and list views'
arch=('x86_64' 'aarch64')
license=('unknown')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
options=('!lto')
source=("dvt::git+file://$(realpath "${startdir:-$PWD}/../..")")
sha256sums=('SKIP')

pkgver() {
  cd dvt
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd dvt
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd dvt
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd dvt
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd dvt
  install -Dm755 target/release/dvt "$pkgdir/usr/bin/dvt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
