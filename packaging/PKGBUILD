# Maintainer: Andrew Imm
pkgname=dvt
pkgver=0.2.0
pkgrel=1
pkgdesc='Read-only terminal disk usage visualizer with treemap and list views'
arch=('x86_64' 'aarch64')
url='https://github.com/andrewimm/dvt'
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
# Whether a -debug package is split out depends on the local makepkg.conf;
# said here so every machine produces the same single package.
options=(!debug)

# Built from the checkout this file sits in rather than a release tarball: a
# tarball's checksum can't be known until its tag exists, and pushing the tag is
# what starts the release build. This also guarantees the package is built from
# exactly what was tagged. pkgver must match Cargo.toml; the release workflow
# checks (packaging/release-check.sh).
source=()

# $startdir is where makepkg was run, so this is the repository around it.
_repo() {
    cd "$startdir/.."
}

prepare() {
    _repo
    # The repo's rust-toolchain.toml would otherwise pick the compiler.
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    _repo
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    _repo
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    _repo
    install -Dm755 target/release/dvt "$pkgdir/usr/bin/dvt"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
